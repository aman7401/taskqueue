# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required — Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/taskqueue?sslmode=disable

# Optional — server listen address (default :8080)
ADDR=:8080

# Optional — comma-separated queue names workers will poll (default: default,emails,notifications)
QUEUES=default,emails,notifications

# Optional — CLI: base URL of the running server (default: http://localhost:8080)
TQ_SERVER=http://localhost:8080
